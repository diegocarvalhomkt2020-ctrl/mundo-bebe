---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos.json';

const categoria = dados.categorias.find((c) => c.id === 'berco-bebe');
const produtos = categoria.produtos;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://mundobebe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Berço/Moisés", item: "https://mundobebe.dicasinteligentes.com/berco-bebe/" },
  ],
};

const faq = [
  {
    pergunta: "Berço fixo ou moisés portátil, qual escolher primeiro?",
    resposta: "Depende do espaço e do plano de uso. Moisés portátil serve bem os primeiros meses e cabe no quarto dos pais (alguns modelos até acoplam na cama). Berço fixo é maior, mas acompanha a criança por mais tempo. Se o orçamento permite só um, pense em onde o bebê vai dormir a maior parte do tempo nos primeiros 6 meses.",
  },
  {
    pergunta: "Preciso trocar o colchonete que vem com o berço?",
    resposta: "Em alguns modelos vale a pena — o colchonete de fábrica costuma ser mais fino que o ideal pra conforto, mesmo em produtos aprovados pelo Inmetro (a aprovação garante segurança estrutural, não espessura de conforto). Meça o berço antes de comprar um substituto pra garantir o encaixe certo.",
  },
  {
    pergunta: "Berço de co-sleeping (acoplado à cama) é seguro?",
    resposta: "Pode ser, desde que o encaixe com a cama dos pais seja perfeito (sem espaço entre os dois) e o modelo tenha aprovação de segurança declarada. Não é o mesmo que dividir a cama de verdade — o bebê continua no próprio espaço, só mais perto.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: { "@type": "Answer", text: item.resposta },
  })),
};
---
<Layout
  title="Berço e moisés para bebê: qual escolher"
  description="Berços e moisés pesquisados na Amazon, com preço, nota e o defeito real de cada um, com checagem de segurança e aprovação Inmetro, pra escolher sem chute."
  image="/images/produtos/safety1st-berco-mini-play-grey-denim.png"
>
  <p><a href="/">← Início</a></p>
  <h1>Berço e moisés para bebê: qual escolher</h1>
  <p class="atualizado">Todos os produtos abaixo foram pesquisados na Amazon, com preço, nota e avaliações reais.</p>

  <p>
    Berço errado sobra em pouco tempo (peso máximo baixo demais) ou nunca
    se encaixa no quarto (grande demais pro espaço). Nessa lista só entram
    modelos com aprovação Inmetro declarada ou marca rastreável, sem
    relato recorrente de falha estrutural na pesquisa.
  </p>

  <section class="como-escolhemos">
    <h2>Como escolhemos</h2>
    <p>
      Além da pesquisa de avaliação normal, checamos aprovação Inmetro e
      reclamação de segurança registrada em cada modelo. Preço sempre em
      faixa, nunca fixo. Nenhum produto entra sem um defeito real
      declarado (bloco "Vale saber" em cada card).
    </p>
  </section>

  <section class="comparativo">
    <h2>Comparativo rápido</h2>
    <div class="tabela-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Produto</th>
            <th scope="col">Preço</th>
            <th scope="col">Selo</th>
            <th scope="col"><span class="sr-only">Ação</span></th>
          </tr>
        </thead>
        <tbody>
          {produtos.map((produto) => (
            <tr>
              <td data-label="Produto">{produto.nome}</td>
              <td data-label="Preço">{produto.precoMin === produto.precoMax ? `R$ ${produto.precoMin}` : `R$ ${produto.precoMin} a R$ ${produto.precoMax}`}</td>
              <td data-label="Selo">{produto.selo || "—"}</td>
              <td data-label="">
                <a class="botao-tabela" href={produto.linkAmazon} rel="sponsored nofollow">Ver preço</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="honestidade">
    <h2>Onde vale gastar mais, onde não faz diferença</h2>
    <p>
      A diferença de preço entre o mais barato (~R$320, moisés de 9kg) e o
      mais caro (~R$1.099, berço de 0 a 20kg) é sobre quanto tempo o
      produto acompanha o bebê, não sobre segurança básica — todos os
      modelos desta lista têm aprovação de segurança declarada ou marca
      rastreável. Se o plano é usar só os primeiros meses, o moisés
      MaxiBaby resolve gastando bem menos. O Safety 1st Falcon (0-20kg) só
      vale a diferença de preço se você não quer trocar de berço no meio
      do caminho.
    </p>
  </section>

  <section id="berco-bebe" class="categoria">
    <h2>{categoria.nome}</h2>
    <p>{categoria.descricao}</p>
    {produtos.map((produto) => <ProdutoCard produto={produto} />)}
  </section>

  <p class="cluster-link">
    Veja também:
    <a href="/berco-bebe/erros-comuns/">os erros mais comuns escolhendo berço →</a>
    ·
    <a href="/berco-bebe/por-orcamento/">os mesmos berços por orçamento →</a>
    ·
    <a href="/berco-bebe/comparativo-top3/">comparativo Top 3 lado a lado →</a>
    ·
    <a href="/carrinho-bebe/">já viu nosso comparativo de carrinho de bebê? →</a>
  </p>

  <section class="faq">
    <h2>Perguntas frequentes</h2>
    {faq.map((item) => (
      <div class="faq-item">
        <h3>{item.pergunta}</h3>
        <p>{item.resposta}</p>
      </div>
    ))}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .cluster-link { font-weight: 600; margin: 2.5rem 0 0; line-height: 2; }
    .como-escolhemos {
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0;
    }
    .como-escolhemos h2 { font-size: 1rem; margin: 0 0 0.4rem; }
    .como-escolhemos p { margin: 0; font-size: 0.9rem; color: var(--cor-texto-suave); }
    .comparativo { margin: 1.5rem 0 2.5rem; }
    .tabela-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 0.85rem; }
    th, td {
      text-align: left;
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid var(--cor-borda);
      white-space: normal;
      overflow-wrap: break-word;
    }
    th { color: var(--cor-texto-suave); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; }
    th:nth-child(1), td:nth-child(1) { width: 40%; }
    th:nth-child(2), td:nth-child(2) { width: 22%; }
    th:nth-child(3), td:nth-child(3) { width: 20%; }
    th:nth-child(4), td:nth-child(4) { width: 18%; }
    .botao-tabela {
      display: inline-block;
      background: var(--cor-acento);
      color: #fff;
      text-decoration: none;
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      font-size: 0.76rem;
      white-space: nowrap;
    }
    .categoria { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .honestidade {
      margin: 2.5rem 0;
      padding: 1.5rem 1.75rem;
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-left: 4px solid var(--cor-vale-saber);
      border-radius: 10px;
    }
    .honestidade h2 { margin: 0 0 0.75rem; font-size: 1.15rem; }
    .honestidade p { margin: 0; color: var(--cor-texto-suave); }
    .faq {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
    }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.35rem; }
    .faq-item p { margin: 0; color: var(--cor-texto-suave); }

    @media (max-width: 640px) {
      table, thead, tbody, th, td, tr { display: block; }
      thead { position: absolute; left: -9999px; }
      tr {
        border: 1px solid var(--cor-borda);
        border-radius: 10px;
        padding: 0.75rem 0.9rem;
        margin-bottom: 0.75rem;
        background: var(--cor-superficie);
      }
      td {
        border: none;
        padding: 0.35rem 0;
        white-space: normal;
        width: auto !important;
      }
      td[data-label="Preço"] { white-space: nowrap; }
      td[data-label]:not([data-label=""])::before {
        content: attr(data-label);
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--cor-texto-suave);
        margin-bottom: 0.1rem;
      }
      td:last-child { padding-top: 0.6rem; }
    }
  </style>
</Layout>
