---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos.json';

const categoria = dados.categorias.find((c) => c.id === 'banheira-bebe');
const produtos = categoria.produtos;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://mundobebe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Banheira para bebê", item: "https://mundobebe.dicasinteligentes.com/banheira-bebe/" },
  ],
};

const faq = [
  {
    pergunta: "Banheira com suporte de pé vale o preço mais alto?",
    resposta: "Vale se você não tem onde apoiar a banheira sem curvar a coluna toda vez. Se já tem um lugar de altura boa (bancada, borda de banheira grande), pode economizar e comprar sem suporte.",
  },
  {
    pergunta: "Até que peso dá pra usar a banheira pra bebê?",
    resposta: "Varia por modelo, mas é comum o limite do suporte ser menor que o da banheira em si — confira sempre os dois números (capacidade da banheira e do suporte, se vier com um) antes de comprar.",
  },
  {
    pergunta: "Banheira dobrável de silicone é resistente o bastante?",
    resposta: "Pra uso doméstico normal, sim — mas tem menos rigidez estrutural que uma banheira de plástico rígido. Se o plano é usar todo dia por muito tempo, uma banheira rígida tende a durar mais.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: { "@type": "Answer", text: item.resposta },
  })),
};
---
<Layout
  title="Banheira para bebê: qual escolher"
  description="Banheiras de bebê pesquisadas na Amazon, com preço, nota e o defeito real de cada uma, pra escolher sem chute."
  image="/images/produtos/burigotto-banheira-millenia-mescla-silver.png"
>
  <p><a href="/">← Início</a></p>
  <h1>Banheira para bebê: qual escolher</h1>
  <p class="atualizado">Todos os produtos abaixo foram pesquisados na Amazon, com preço, nota e avaliações reais.</p>

  <p>
    Banheira errada vira dor nas costas todo dia (baixa demais, sem
    suporte) ou risco de escorregão. Nessa lista só entram modelos de
    marca com histórico de mercado, com o limite de peso/capacidade
    declarado.
  </p>

  <section class="como-escolhemos">
    <h2>Como escolhemos</h2>
    <p>
      Além da nota e volume de avaliações, conferimos a capacidade
      declarada (banheira e suporte, quando existe) e procuramos
      reclamação específica de segurança no Reclame Aqui de cada marca e
      modelo, não só reclamação de conforto — um modelo com relato
      recorrente de queda ou estrutura que solta fica de fora da lista,
      mesmo com nota boa. Preço sempre em faixa, nunca fixo. Nenhum
      produto entra sem um defeito real declarado.
    </p>
  </section>

  <section class="comparativo">
    <h2>Comparativo rápido</h2>
    <div class="tabela-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Produto</th>
            <th scope="col">Preço</th>
            <th scope="col">Selo</th>
            <th scope="col"><span class="sr-only">Ação</span></th>
          </tr>
        </thead>
        <tbody>
          {produtos.map((produto) => (
            <tr>
              <td data-label="Produto">{produto.nome}</td>
              <td data-label="Preço">{produto.precoMin === produto.precoMax ? `R$ ${produto.precoMin}` : `R$ ${produto.precoMin} a R$ ${produto.precoMax}`}</td>
              <td data-label="Selo">{produto.selo || "—"}</td>
              <td data-label="">
                <a class="botao-tabela" href={produto.linkAmazon} rel="sponsored nofollow">Ver preço</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="honestidade">
    <h2>Onde vale gastar mais, onde não faz diferença</h2>
    <p>
      A diferença de preço entre a mais barata (~R$142, dobrável) e a mais
      cara (~R$799, com suporte de pé) é principalmente sobre conforto de
      quem dá o banho (curvar a coluna ou não) e praticidade de guardar —
      as 4 desta lista passaram pela checagem de reclamação de segurança
      e nenhuma tem relato recorrente de queda ou estrutura que solta,
      só pontos de durabilidade (enferrujamento do suporte com o tempo,
      principalmente). Se o espaço é apertado, a Pipdip dobrável resolve
      bem. Se você vai dar banho todo dia por meses e sente a coluna
      reclamar, o suporte de pé da Safety 1st compensa o preço mais alto,
      mas seque bem a estrutura depois de cada banho pra não enferrujar.
    </p>
  </section>

  <section id="banheira-bebe" class="categoria">
    <h2>{categoria.nome}</h2>
    <p>{categoria.descricao}</p>
    {produtos.map((produto) => <ProdutoCard produto={produto} />)}
  </section>

  <p class="cluster-link">
    Veja também:
    <a href="/banheira-bebe/erros-comuns/">os erros mais comuns escolhendo banheira →</a>
    ·
    <a href="/banheira-bebe/por-orcamento/">as mesmas banheiras por orçamento →</a>
    ·
    <a href="/banheira-bebe/comparativo-top3/">comparativo Top 3 lado a lado →</a>
    ·
    <a href="/berco-bebe/">já viu nosso comparativo de berço e moisés? →</a>
  </p>

  <section class="faq">
    <h2>Perguntas frequentes</h2>
    {faq.map((item) => (
      <div class="faq-item">
        <h3>{item.pergunta}</h3>
        <p>{item.resposta}</p>
      </div>
    ))}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .cluster-link { font-weight: 600; margin: 2.5rem 0 0; line-height: 2; }
    .como-escolhemos {
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0;
    }
    .como-escolhemos h2 { font-size: 1rem; margin: 0 0 0.4rem; }
    .como-escolhemos p { margin: 0; font-size: 0.9rem; color: var(--cor-texto-suave); }
    .comparativo { margin: 1.5rem 0 2.5rem; }
    .tabela-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 0.85rem; }
    th, td {
      text-align: left;
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid var(--cor-borda);
      white-space: normal;
      overflow-wrap: break-word;
    }
    th { color: var(--cor-texto-suave); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; }
    th:nth-child(1), td:nth-child(1) { width: 40%; }
    th:nth-child(2), td:nth-child(2) { width: 22%; }
    th:nth-child(3), td:nth-child(3) { width: 20%; }
    th:nth-child(4), td:nth-child(4) { width: 18%; }
    .botao-tabela {
      display: inline-block;
      background: var(--cor-acento);
      color: #fff;
      text-decoration: none;
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      font-size: 0.76rem;
      white-space: nowrap;
    }
    .categoria { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .honestidade {
      margin: 2.5rem 0;
      padding: 1.5rem 1.75rem;
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-left: 4px solid var(--cor-vale-saber);
      border-radius: 10px;
    }
    .honestidade h2 { margin: 0 0 0.75rem; font-size: 1.15rem; }
    .honestidade p { margin: 0; color: var(--cor-texto-suave); }
    .faq {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
    }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.35rem; }
    .faq-item p { margin: 0; color: var(--cor-texto-suave); }

    @media (max-width: 640px) {
      table, thead, tbody, th, td, tr { display: block; }
      thead { position: absolute; left: -9999px; }
      tr {
        border: 1px solid var(--cor-borda);
        border-radius: 10px;
        padding: 0.75rem 0.9rem;
        margin-bottom: 0.75rem;
        background: var(--cor-superficie);
      }
      td {
        border: none;
        padding: 0.35rem 0;
        white-space: normal;
        width: auto !important;
      }
      td[data-label="Preço"] { white-space: nowrap; }
      td[data-label]:not([data-label=""])::before {
        content: attr(data-label);
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--cor-texto-suave);
        margin-bottom: 0.1rem;
      }
      td:last-child { padding-top: 0.6rem; }
    }
  </style>
</Layout>
