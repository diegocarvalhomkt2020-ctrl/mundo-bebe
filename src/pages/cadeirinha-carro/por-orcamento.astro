---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos.json';

const categoria = dados.categorias.find((c) => c.id === 'cadeirinha-carro');
const produtos = [...categoria.produtos].sort((a, b) => a.precoMin - b.precoMin);

const faixas = [
  { titulo: "Até R$500", min: 0, max: 500 },
  { titulo: "R$500 a R$1.000", min: 500, max: 1000 },
  { titulo: "Acima de R$1.000", min: 1000, max: Infinity },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://mundobebe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Cadeirinha para carro", item: "https://mundobebe.dicasinteligentes.com/cadeirinha-carro/" },
    { "@type": "ListItem", position: 3, name: "Por orçamento", item: "https://mundobebe.dicasinteligentes.com/cadeirinha-carro/por-orcamento/" },
  ],
};
---
<Layout
  title="Cadeirinha para carro por orçamento"
  description="As mesmas cadeirinhas para carro pesquisadas na Amazon, separadas por faixa de preço, do mais barato ao mais completo, com nota e contra real de cada uma."
>
  <p><a href="/cadeirinha-carro/">← Cadeirinha para carro</a></p>
  <h1>Cadeirinha para carro por orçamento</h1>
  <p>Os mesmos produtos do guia principal, separados por faixa de preço.</p>

  {faixas.map((faixa) => {
    const produtosFaixa = produtos.filter((p) => p.precoMin >= faixa.min && p.precoMin < faixa.max);
    return produtosFaixa.length > 0 && (
      <section class="faixa">
        <h2>{faixa.titulo}</h2>
        {produtosFaixa.map((produto) => <ProdutoCard produto={produto} />)}
      </section>
    );
  })}

  <p class="cta-final">
    Quer ver o comparativo completo?
    <a href="/cadeirinha-carro/">Volte pro guia completo →</a>
  </p>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .faixa { margin: 2rem 0; }
    .faixa h2 { font-size: 1.1rem; margin: 0 0 1rem; color: var(--cor-acento); }
    .cta-final {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
