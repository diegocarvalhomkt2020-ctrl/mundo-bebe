---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos.json';

const categoria = dados.categorias.find((c) => c.id === 'cadeirinha-carro');
const produtos = categoria.produtos;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://mundobebe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Cadeirinha para carro", item: "https://mundobebe.dicasinteligentes.com/cadeirinha-carro/" },
  ],
};

const faq = [
  {
    pergunta: "Cadeirinha 0-36kg ou trocar de cadeirinha conforme a criança cresce?",
    resposta: "Depende do que pesa mais pra você. Uma cadeirinha 0-36kg (Cosco Progress) resolve numa compra só, mas é grande e ocupa bastante espaço no banco desde cedo. Trocar em etapas (bebê conforto, depois 9-36kg) custa mais no total, mas cada fase fica mais compacta e ajustada ao tamanho real da criança naquele momento.",
  },
  {
    pergunta: "Vale a pena pagar mais por Isofix?",
    resposta: "Isofix trava direto na estrutura do carro, sem depender do cinto de segurança pra prender a cadeirinha, o que reduz erro de instalação. Só compensa se o seu carro tiver esse encaixe, verifique no manual do veículo antes de decidir.",
  },
  {
    pergunta: "Cadeirinha muito mais cara é sempre mais segura?",
    resposta: "Não necessariamente. Todo produto vendido no Brasil passa pelas mesmas normas mínimas de segurança do Inmetro. A diferença de preço nas opções mais caras da lista é sobre recurso (giro 360°, facilidade de instalação, acolchoado premium), não sobre o item ser \"mais seguro\" no sentido básico.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: { "@type": "Answer", text: item.resposta },
  })),
};
---
<Layout
  title="Cadeirinha para carro: qual escolher"
  description="Cadeirinhas para carro pesquisadas na Amazon, com preço, nota e o defeito real de cada uma, incluindo checagem de segurança, pra escolher sem chute."
>
  <p><a href="/">← Início</a></p>
  <h1>Cadeirinha para carro: qual escolher</h1>
  <p class="atualizado">Todos os produtos abaixo foram pesquisados na Amazon, com preço, nota e avaliações reais. Fotos ainda em produção.</p>

  <p>
    Cadeirinha errada não é só desconforto, é risco de segurança de
    verdade. Os produtos abaixo estão em ordem de preço: da mais barata
    até a mais completa, sempre com o defeito real de cada uma, não só a
    nota 5 estrelas.
  </p>

  <section class="como-escolhemos">
    <h2>Como escolhemos</h2>
    <p>
      Nenhuma cadeirinha entra nessa lista sem um defeito real declarado
      (bloco "Vale saber" em cada card), pesquisado em avaliação de
      comprador de verdade, nunca inventado. Preço sempre em faixa, nunca
      fixo.
    </p>
  </section>

  <section class="comparativo">
    <h2>Comparativo rápido</h2>
    <div class="tabela-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Produto</th>
            <th scope="col">Preço</th>
            <th scope="col">Selo</th>
            <th scope="col"><span class="sr-only">Ação</span></th>
          </tr>
        </thead>
        <tbody>
          {produtos.map((produto) => (
            <tr>
              <td data-label="Produto">{produto.nome}</td>
              <td data-label="Preço">R$ {produto.precoMin} a R$ {produto.precoMax}</td>
              <td data-label="Selo">{produto.selo || "—"}</td>
              <td data-label="">
                <a class="botao-tabela" href={produto.linkAmazon} rel="sponsored nofollow">Ver preço</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="honestidade">
    <h2>Onde vale gastar mais, onde não faz diferença</h2>
    <p>
      A diferença de preço entre a mais barata (~R$370) e a mais premium
      (~R$3.000) não é sobre segurança básica, todas seguem a mesma norma
      do Inmetro. É sobre recurso: Isofix, giro 360°, capacidade de cobrir
      do nascimento até 36kg numa cadeira só. Se o seu carro não tem
      Isofix e você não precisa do giro 360°, uma opção intermediária como
      a Cosco Progress já resolve bem. Só vale pagar o topo de linha se um
      desses recursos específicos for importante pra sua rotina.
    </p>
  </section>

  <section id="cadeirinha-carro" class="categoria">
    <h2>{categoria.nome}</h2>
    <p>{categoria.descricao}</p>
    {produtos.map((produto) => <ProdutoCard produto={produto} />)}
  </section>

  <p class="cluster-link">
    Veja também:
    <a href="/cadeirinha-carro/erros-comuns/">os erros mais comuns escolhendo cadeirinha →</a>
    ·
    <a href="/cadeirinha-carro/por-orcamento/">as mesmas cadeirinhas por orçamento →</a>
    ·
    <a href="/cadeirinha-carro/comparativo-top3/">comparativo Top 3 lado a lado →</a>
  </p>

  <section class="faq">
    <h2>Perguntas frequentes</h2>
    {faq.map((item) => (
      <div class="faq-item">
        <h3>{item.pergunta}</h3>
        <p>{item.resposta}</p>
      </div>
    ))}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }
    .atualizado { color: var(--cor-texto-suave); font-size: 0.9rem; }
    .cluster-link { font-weight: 600; margin: 2.5rem 0 0; line-height: 2; }
    .como-escolhemos {
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin: 1.5rem 0;
    }
    .como-escolhemos h2 { font-size: 1rem; margin: 0 0 0.4rem; }
    .como-escolhemos p { margin: 0; font-size: 0.9rem; color: var(--cor-texto-suave); }
    .comparativo { margin: 1.5rem 0 2.5rem; }
    .tabela-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 0.85rem; }
    th, td {
      text-align: left;
      padding: 0.6rem 0.5rem;
      border-bottom: 1px solid var(--cor-borda);
      white-space: normal;
      overflow-wrap: break-word;
    }
    th { color: var(--cor-texto-suave); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; }
    th:nth-child(1), td:nth-child(1) { width: 40%; }
    th:nth-child(2), td:nth-child(2) { width: 22%; }
    th:nth-child(3), td:nth-child(3) { width: 20%; }
    th:nth-child(4), td:nth-child(4) { width: 18%; }
    .botao-tabela {
      display: inline-block;
      background: var(--cor-acento);
      color: #fff;
      text-decoration: none;
      padding: 0.3rem 0.55rem;
      border-radius: 999px;
      font-size: 0.76rem;
      white-space: nowrap;
    }
    .categoria { margin-bottom: 2.5rem; padding-top: 0.5rem; }
    .honestidade {
      margin: 2.5rem 0;
      padding: 1.5rem 1.75rem;
      background: var(--cor-superficie);
      border: 1px solid var(--cor-borda);
      border-left: 4px solid var(--cor-vale-saber);
      border-radius: 10px;
    }
    .honestidade h2 { margin: 0 0 0.75rem; font-size: 1.15rem; }
    .honestidade p { margin: 0; color: var(--cor-texto-suave); }
    .faq {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
    }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.35rem; }
    .faq-item p { margin: 0; color: var(--cor-texto-suave); }

    @media (max-width: 640px) {
      table, thead, tbody, th, td, tr { display: block; }
      thead { position: absolute; left: -9999px; }
      tr {
        border: 1px solid var(--cor-borda);
        border-radius: 10px;
        padding: 0.75rem 0.9rem;
        margin-bottom: 0.75rem;
        background: var(--cor-superficie);
      }
      td {
        border: none;
        padding: 0.35rem 0;
        white-space: normal;
      }
      td[data-label="Preço"] { white-space: nowrap; }
      td[data-label]:not([data-label=""])::before {
        content: attr(data-label);
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--cor-texto-suave);
        margin-bottom: 0.1rem;
      }
      td:last-child { padding-top: 0.6rem; }
    }
  </style>
</Layout>
