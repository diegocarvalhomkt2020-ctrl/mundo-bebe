---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos.json';

const categoria = dados.categorias.find((c) => c.id === 'baba-eletronica');
const produtos = [...categoria.produtos].sort((a, b) => a.precoMin - b.precoMin);

const faixas = [
  { titulo: "Até R$100", min: 0, max: 100 },
  { titulo: "R$100 a R$350", min: 100, max: 350 },
  { titulo: "Acima de R$350", min: 350, max: Infinity },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://mundobebe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Babá eletrônica", item: "https://mundobebe.dicasinteligentes.com/baba-eletronica/" },
    { "@type": "ListItem", position: 3, name: "Por orçamento", item: "https://mundobebe.dicasinteligentes.com/baba-eletronica/por-orcamento/" },
  ],
};
---
<Layout
  title="Babá eletrônica por orçamento"
  description="As mesmas babás eletrônicas pesquisadas na Amazon, separadas por faixa de preço, do mais barato ao mais completo."
>
  <p><a href="/baba-eletronica/">← Babá eletrônica</a></p>
  <h1>Babá eletrônica por orçamento</h1>
  <p>Os mesmos produtos do guia principal, separados por faixa de preço.</p>

  <section class="raciocinio">
    <h2>O que muda de verdade entre as faixas</h2>
    <p>
      Até R$100 a câmera smart com app depende 100% da internet de casa: se
      a conexão cair, o monitoramento cai junto, e ainda tem poucas
      avaliações acumuladas. Na faixa de R$100 a R$350 estão as duas mais
      populares, mas com uma troca oposta entre elas: a mais vendida não
      tem Wi-Fi, só funciona com a tela dedicada (não dá pra checar o bebê
      fora de casa), enquanto a genérica tem Wi-Fi mas não tem loja física
      nem suporte pós-venda formal no Brasil, então em caso de defeito o
      caminho de garantia é só pelo canal da Amazon. Acima de R$350 tanto
      a OLANENEM quanto a Motorola também não têm Wi-Fi, é uma troca
      deliberada de privacidade por não depender de internet, e a Motorola
      especificamente tem a nota mais baixa de toda a lista mesmo sendo a
      marca mais conhecida.
    </p>
  </section>

  {faixas.map((faixa) => {
    const produtosFaixa = produtos.filter((p) => p.precoMin >= faixa.min && p.precoMin < faixa.max);
    return produtosFaixa.length > 0 && (
      <section class="faixa">
        <h2>{faixa.titulo}</h2>
        {produtosFaixa.map((produto) => <ProdutoCard produto={produto} />)}
      </section>
    );
  })}

  <p class="cta-final">
    Quer ver o comparativo completo?
    <a href="/baba-eletronica/">Volte pro guia completo →</a>
  </p>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .faixa { margin: 2rem 0; }
    .faixa h2 { font-size: 1.1rem; margin: 0 0 1rem; color: var(--cor-acento); }
    .cta-final {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
