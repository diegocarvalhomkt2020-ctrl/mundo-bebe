---
import Layout from '../../layouts/Layout.astro';
import ProdutoCard from '../../components/ProdutoCard.astro';
import dados from '../../data/produtos.json';

const categoria = dados.categorias.find((c) => c.id === 'carrinho-bebe');
const produtos = [...categoria.produtos].sort((a, b) => a.precoMin - b.precoMin);

const faixas = [
  { titulo: "Até R$1.000", min: 0, max: 1000 },
  { titulo: "R$1.000 a R$2.000", min: 1000, max: 2000 },
  { titulo: "Acima de R$2.000", min: 2000, max: Infinity },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://mundobebe.dicasinteligentes.com/" },
    { "@type": "ListItem", position: 2, name: "Carrinho de bebê", item: "https://mundobebe.dicasinteligentes.com/carrinho-bebe/" },
    { "@type": "ListItem", position: 3, name: "Por orçamento", item: "https://mundobebe.dicasinteligentes.com/carrinho-bebe/por-orcamento/" },
  ],
};
---
<Layout
  title="Carrinho de bebê por orçamento"
  description="Os mesmos carrinhos de bebê pesquisados na Amazon, separados por faixa de preço, do mais barato ao mais completo."
>
  <p><a href="/carrinho-bebe/">← Carrinho de bebê</a></p>
  <h1>Carrinho de bebê por orçamento</h1>
  <p>Os mesmos produtos do guia principal, separados por faixa de preço.</p>

  <section class="raciocinio">
    <h2>O que muda de verdade entre as faixas</h2>
    <p>
      Nessa categoria, subir de faixa não significa necessariamente um
      carrinho melhor pro recém-nascido, significa um uso diferente. Os dois
      modelos até R$1.000 já são travel systems reclináveis, prontos pra
      recém-nascido desde o início, mas cada um com uma ressalva própria:
      reforçar o acolchoado na altura da cabeça no Reverse Duo, e evitar
      calçada muito irregular no Zap Metal. Já na faixa de R$1.000 a R$2.000
      está o Eva³, pensado pra compactar em viagem, mas que só funciona bem
      a partir de uns 6 meses, não é o mais indicado pro bebê recém-nascido.
      Acima de R$2.000 o Leona² é o mais robusto, porém mais pesado no
      dia a dia e com relato registrado de ferrugem no rolamento das rodas,
      então vale fotografar o produto ao receber e guardar a nota fiscal.
    </p>
  </section>

  {faixas.map((faixa) => {
    const produtosFaixa = produtos.filter((p) => p.precoMin >= faixa.min && p.precoMin < faixa.max);
    return produtosFaixa.length > 0 && (
      <section class="faixa">
        <h2>{faixa.titulo}</h2>
        {produtosFaixa.map((produto) => <ProdutoCard produto={produto} />)}
      </section>
    );
  })}

  <p class="cta-final">
    Quer ver o comparativo completo?
    <a href="/carrinho-bebe/">Volte pro guia completo →</a>
  </p>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .faixa { margin: 2rem 0; }
    .faixa h2 { font-size: 1.1rem; margin: 0 0 1rem; color: var(--cor-acento); }
    .cta-final {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--cor-borda);
      font-weight: 600;
    }
  </style>
</Layout>
